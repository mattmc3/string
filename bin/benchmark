#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

just publish-native

bin="./publish/string"
filter="${1:-}"

section() {
    local name="$1"
    [[ -z "$filter" || "$name" == *"$filter"* ]]
}

if section lower; then
    echo "=== lower / upper ==="
    hyperfine \
      --warmup 10 \
      --shell=none \
      "$bin lower Foo BAR baz" \
      "$bin upper Foo BAR baz" \
      "fish -N -c 'string lower Foo BAR baz'" \
      "fish -N -c 'string upper Foo BAR baz'"
fi

if section trim; then
    echo "=== trim (internal variants) ==="
    hyperfine \
      --warmup 10 \
      --shell=none \
      "$bin trim -c x xxhelloxx" \
      "$bin trim -l -c x xxhelloxx" \
      "$bin trim -r -c x xxhelloxx"

    echo "=== trim vs fish ==="
    hyperfine \
      --warmup 10 \
      --shell=none \
      "$bin trim -c x xxhelloxx" \
      "fish -N -c 'string trim -c x xxhelloxx'"
fi

if section match; then
    echo "=== match ==="
    hyperfine \
      --warmup 10 \
      --shell=none \
      "$bin match 'foo*' foobar" \
      "$bin match -r 'fo+' foobar" \
      "$bin match -r -a 'o+' foobaroo" \
      "$bin match -v 'foo' foo bar baz" \
      "fish -N -c 'string match \"foo*\" foobar'" \
      "fish -N -c 'string match -r fo+ foobar'" \
      "fish -N -c 'string match -r -a o+ foobaroo'" \
      "fish -N -c 'string match -v foo foo bar baz'"
fi

if section repeat; then
    echo "=== repeat ==="
    hyperfine \
      --warmup 10 \
      --shell=none \
      "$bin repeat -n 5 abc" \
      "$bin repeat -n 5 -m 10 abc" \
      "fish -N -c 'string repeat -n 5 abc'" \
      "fish -N -c 'string repeat -n 5 --max 10 abc'"
fi

if section length; then
    echo "=== length ==="
    hyperfine \
      --warmup 10 \
      --shell=none \
      "$bin length hello" \
      "$bin length hello world foo" \
      "fish -N -c 'string length hello'" \
      "fish -N -c 'string length hello world foo'"
fi

if section sub; then
    echo "=== sub ==="
    hyperfine \
      --warmup 10 \
      --shell=none \
      "$bin sub -s 2 -l 3 hello" \
      "$bin sub -s -3 hello" \
      "fish -N -c 'string sub -s 2 -l 3 hello'" \
      "fish -N -c 'string sub -s -3 hello'"
fi

if section split; then
    echo "=== split ==="
    hyperfine \
      --warmup 10 \
      --shell=none \
      "$bin split , a,b,c" \
      "$bin split -r -m 1 , a,b,c" \
      "fish -N -c 'string split , a,b,c'" \
      "fish -N -c 'string split -r -m 1 , a,b,c'"
fi

if section join; then
    echo "=== join ==="
    hyperfine \
      --warmup 10 \
      --shell=none \
      "$bin join , a b c" \
      "$bin join0 a b c" \
      "fish -N -c 'string join , a b c'" \
      "fish -N -c 'string join0 a b c'"
fi

if section replace; then
    echo "=== replace ==="
    hyperfine \
      --warmup 10 \
      --shell=none \
      "$bin replace foo bar 'foo baz foo'" \
      "$bin replace -a foo bar 'foo baz foo'" \
      "$bin replace -r 'f(o+)' 'b\1' foobar" \
      "fish -N -c 'string replace foo bar foobar'" \
      "fish -N -c 'string replace -a foo bar \"foo baz foo\"'" \
      "fish -N -c 'string replace -r fo+ bar foobar'"
fi

if section pad; then
    echo "=== pad ==="
    hyperfine \
      --warmup 10 \
      --shell=none \
      "$bin pad -w 10 foo" \
      "$bin pad -w 10 -c = foo" \
      "$bin pad -w 10 -C foo" \
      "fish -N -c 'string pad -w 10 foo'" \
      "fish -N -c 'string pad -w 10 -c = foo'" \
      "fish -N -c 'string pad -w 10 -C foo'"
fi

if section shorten; then
    echo "=== shorten ==="
    hyperfine \
      --warmup 10 \
      --shell=none \
      "$bin shorten -m 8 'hello world'" \
      "$bin shorten -m 8 --char '~' 'hello world'" \
      "fish -N -c 'string shorten -m 8 \"hello world\"'" \
      "fish -N -c 'string shorten -m 8 --char ~ \"hello world\"'"
fi

if section escape; then
    echo "=== escape ==="
    hyperfine \
      --warmup 10 \
      --shell=none \
      "$bin escape 'hello world'" \
      "$bin escape --style=url 'hello world'" \
      "$bin unescape 'hello\ world'" \
      "fish -N -c 'string escape \"hello world\"'" \
      "fish -N -c 'string escape --style=url \"hello world\"'" \
      "fish -N -c 'string unescape \"hello\\\\ world\"'"
fi

if section collect; then
    echo "=== collect ==="
    hyperfine \
      --warmup 10 \
      --shell=none \
      "$bin collect foo bar baz" \
      "$bin collect -N foo bar baz" \
      "fish -N -c 'string collect foo bar baz'" \
      "fish -N -c 'string collect -N foo bar baz'"
fi
