<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>string</AssemblyName>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishDir>$(MSBuildProjectDirectory)/../../publish</PublishDir>
  </PropertyGroup>

  <!-- Add Homebrew library paths for macOS Native AOT -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <LinkerArg Include="-L/opt/homebrew/opt/openssl@3/lib" />
    <LinkerArg Include="-L/opt/homebrew/opt/brotli/lib" />
  </ItemGroup>

</Project>
